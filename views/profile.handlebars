<div class="container mt-4">
    <div class="row justify-content-center" style="display: flex; justify-content: center; width: 100%;">
        <div class="col-md-6" style="grid-column: span 6; width: 100%; max-width: 500px; margin: 0 auto;">
            <div class="card shadow" style="border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
                <!-- Faixa Azul: Título Centralizado -->
                <div class="card-header bg-primary text-white" style="display: flex; justify-content: center; align-items: center; text-align: center; padding: 1.25rem;">
                    <h3 class="mb-0" style="margin-top: 12px; width: 100%; text-align: center; font-weight: 700; letter-spacing: 0.5px;">Meu Perfil</h3>
                </div>
                <div class="card-body" style="padding: 2.5rem 2rem;">
                    <!-- Avatar e Badge: Perfeitamente Centralizados -->
                    <div class="text-center mb-4" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                        <div class="bg-light rounded-circle" style="width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; background-color: #f1f3f5; border-radius: 50%; margin: 0 auto 1rem auto; box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);">
                            <i class="fas fa-user fa-3x text-secondary" style="color: #495057; font-size: 3rem; display: flex; align-items: center; justify-content: center; line-height: 1; height: 100%; width: 100%;"></i>
                        </div>
                        <h4 class="mt-2" style="font-weight: 700; color: #333; margin-top: 0.5rem; margin-bottom: 0.25rem;">{{user.name}}</h4>
                        
                        {{#if (eq user.role "admin")}}
                            <span class="badge bg-primary" style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-purple) 100%); color: white; padding: 0.4rem 1rem; border-radius: 20px; font-weight: 700; font-size: 0.75rem;">ADMINISTRADOR</span>
                        {{else}}
                            <span class="badge bg-info" style="background: linear-gradient(135deg, #0066cc 0%, #3b82f6 100%); color: white; padding: 0.4rem 1rem; border-radius: 20px; font-weight: 700; font-size: 0.75rem;">CLIENTE</span>
                        {{/if}}
                    </div>

                    <!-- Informações do Banco de Dados -->
                    <ul class="list-group list-group-flush" style="border: none; margin-top: 1.5rem; padding: 0; list-style: none;">
                        <li class="list-group-item" style="border-bottom: 1px solid #eee; padding: 1rem 0; display: flex; justify-content: space-between; background: transparent;">
                            <strong style="color: #555;"><i class="fas fa-envelope" style="margin-right: 0.5rem; color: #0066cc;"></i> Email:</strong> 
                            <span style="color: #333; font-weight: 500;">{{user.email}}</span>
                        </li>
                        <li class="list-group-item" style="border-bottom: 1px solid #eee; padding: 1rem 0; display: flex; justify-content: space-between; background: transparent;">
                            <strong style="color: #555;"><i class="fas fa-calendar-alt" style="margin-right: 0.5rem; color: #0066cc;"></i> Membro desde:</strong> 
                            <span style="color: #333; font-weight: 500;">{{user.createdAtFormatted}}</span>
                        </li>
                    </ul>

                    <div class="d-grid gap-2 mt-4" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2rem;">
                        <a href="/dashboard" class="btn btn-outline-primary" style="text-align: center; justify-content: center;">
                            <i class="fas fa-chevron-left" style="margin-right: 0.5rem;"></i> Voltar ao Dashboard
                        </a>
                        <a href="/logout" class="btn btn-danger" style="text-align: center; justify-content: center;">
                            <i class="fas fa-sign-out-alt" style="margin-right: 0.5rem;"></i> Sair da Conta
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
