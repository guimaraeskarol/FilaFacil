<div class="auth-container">
    <div class="auth-card">
        <!-- Cabeçalho da Autenticação -->
        <div class="auth-header">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">
                <i class="fas fa-sign-in-alt"></i>
            </div>
            <h1><i class="fas fa-lock"></i> Login</h1>
            <p>Acesse sua conta FilaFácil</p>
        </div>

        <!-- Mensagens de Erro -->
        {{#if error}}
            <div class="alert alert-error" role="alert">
                <i class="fas fa-exclamation-circle"></i>
                <span>{{error}}</span>
            </div>
        {{/if}}

        <!-- Formulário de Login -->
        <form method="POST" action="/login" class="auth-form" novalidate>
            <!-- Campo Email -->
            <div class="form-group">
                <label for="email">
                    <i class="fas fa-envelope"></i> Email
                </label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="seu@email.com"
                    autocomplete="email"
                    aria-label="Email"
                >
            </div>

            <!-- Campo Senha -->
            <div class="form-group">
                <label for="password">
                    <i class="fas fa-key"></i> Senha
                </label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    required 
                    placeholder="Sua senha"
                    autocomplete="current-password"
                    aria-label="Senha"
                >
            </div>

            <!-- Botão de Envio -->
            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.5rem;">
                <i class="fas fa-arrow-right"></i> Entrar na Conta
            </button>
        </form>

        <!-- Rodapé com Link para Registro -->
        <div class="auth-footer">
            <p>
                Não tem conta? 
                <a href="/register">
                    <i class="fas fa-user-plus"></i> Registre-se aqui
                </a>
            </p>
        </div>
    </div>
</div>

<!-- Dica de Segurança -->
<div style="text-align: center; margin-top: 2rem; color: #666; font-size: 0.85rem;">
    <i class="fas fa-shield-alt"></i> Sua segurança é nossa prioridade. Dados criptografados.
</div>
