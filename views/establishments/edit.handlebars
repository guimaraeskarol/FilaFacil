<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white" style="display: flex; justify-content: center; align-items: center; text-align: center; padding: 1.25rem;">
                    <h3 class="mb-0" style="margin-top: 12px; width: 100%; text-align: center; font-weight: 700; letter-spacing: 0.5px;">Editar Estabelecimento</h3>
                </div>
                <div class="card-body">
                    {{#if error}}
                        <div class="alert alert-danger">{{error}}</div>
                    {{/if}}

                    <form action="/establishments/edit/{{establishment.id}}" method="POST">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="name" class="form-label">Nome do Estabelecimento*</label>
                                <input type="text" class="form-control" id="name" name="name" value="{{establishment.name}}" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="type" class="form-label">Tipo de Negócio*</label>
                                <select class="form-select" id="type" name="type" required>
                                    <option value="Restaurante" {{#if (eq establishment.type 'Restaurante')}}selected{{/if}}>Restaurante</option>
                                    <option value="Clínica" {{#if (eq establishment.type 'Clínica')}}selected{{/if}}>Clínica</option>
                                    <option value="Banco" {{#if (eq establishment.type 'Banco')}}selected{{/if}}>Banco</option>
                                    <option value="Cartório" {{#if (eq establishment.type 'Cartório')}}selected{{/if}}>Cartório</option>
                                    <option value="Outro" {{#if (eq establishment.type 'Outro')}}selected{{/if}}>Outro</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="address" class="form-label">Endereço*</label>
                            <input type="text" class="form-control" id="address" name="address" value="{{establishment.address}}" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="city" class="form-label">Cidade</label>
                                <input type="text" class="form-control" id="city" name="city" value="{{establishment.city}}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="state" class="form-label">Estado</label>
                                <input type="text" class="form-control" id="state" name="state" value="{{establishment.state}}">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="phone" class="form-label">Telefone</label>
                            <input type="text" class="form-control" id="phone" name="phone" value="{{establishment.phone}}">
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="openingHours" class="form-label">Horário de Abertura</label>
                                <input type="time" class="form-control" id="openingHours" name="openingHours" value="{{establishment.openingHours}}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="closingHours" class="form-label">Horário de Fechamento</label>
                                <input type="time" class="form-control" id="closingHours" name="closingHours" value="{{establishment.closingHours}}">
                            </div>
                        </div>

                        <div class="mt-4" style="display: flex; justify-content: center;">
                            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
