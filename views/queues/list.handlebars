<div class="container mt-4">

    <!-- Cabeçalho da Página -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--border-color);">
        <div>
            <h1 style="color: var(--primary-blue); font-weight: 800; font-size: 2rem; margin-bottom: 0.25rem; display: flex; align-items: center; gap: 0.75rem;">
                <i class="fas fa-layer-group" style="color: var(--primary-purple);"></i>
                Filas do Estabelecimento
            </h1>
            <p style="color: var(--gray-text); font-weight: 500; margin: 0;">
                Gerencie as filas de atendimento desta unidade
            </p>
        </div>
        <div>
            {{#if establishment}}
                {{#if (eq user.id establishment.userId)}}
                    <a href="/queues/create/{{establishment.id}}" class="btn btn-success" style="display:inline-flex; align-items:center; gap:0.5rem;">
                        <i class="fas fa-plus"></i> Nova Fila
                    </a>
                {{/if}}
            {{/if}}
        </div>
    </div>

    <!-- Lista de Filas -->
    <div class="row">
        {{#if queues}}
            {{#each queues}}
                <div class="col-md-6 mb-4">
                    <div class="dashboard-card" style="height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                                <div>
                                    <h3 style="color: var(--primary-blue); font-weight: 700; margin-bottom: 0.25rem; font-size: 1.2rem;">
                                        <i class="fas fa-list-ul" style="color: var(--primary-purple); margin-right: 0.5rem;"></i>
                                        {{this.name}}
                                    </h3>
                                    <p style="color: var(--gray-text); font-size: 0.9rem; margin: 0;">{{this.description}}</p>
                                </div>
                                <span class="badge {{#if (eq this.status 'active')}}bg-success{{else}}bg-secondary{{/if}}" style="font-size: 0.8rem; padding: 0.4rem 0.9rem; border-radius: 20px;">
                                    {{#if (eq this.status 'active')}}Ativa{{else}}Inativa{{/if}}
                                </span>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.25rem 0; padding: 1rem; background: linear-gradient(135deg, rgba(0,102,204,0.05) 0%, rgba(124,58,237,0.05) 100%); border-radius: 10px;">
                                <div style="text-align: center;">
                                    <p style="margin: 0; font-size: 0.8rem; color: var(--gray-text); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Capacidade</p>
                                    <p style="margin: 0.25rem 0 0; font-size: 1.4rem; font-weight: 800; color: var(--primary-blue);">{{this.maxCapacity}}</p>
                                    <p style="margin: 0; font-size: 0.75rem; color: var(--gray-text);">pessoas</p>
                                </div>
                                <div style="text-align: center; border-left: 1px solid var(--border-color);">
                                    <p style="margin: 0; font-size: 0.8rem; color: var(--gray-text); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Tempo Médio</p>
                                    <p style="margin: 0.25rem 0 0; font-size: 1.4rem; font-weight: 800; color: var(--primary-purple);">{{this.averageServiceTime}}</p>
                                    <p style="margin: 0; font-size: 0.75rem; color: var(--gray-text);">minutos</p>
                                </div>
                            </div>
                        </div>

                        <a href="/queues/{{this.id}}" class="btn btn-primary" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.8rem; border-radius: 10px; margin-top: 0.5rem;">
                            <i class="fas fa-cogs"></i> Gerenciar Fila
                        </a>
                    </div>
                </div>
            {{/each}}
        {{else}}
            <div class="col-12">
                <div class="dashboard-card" style="text-align: center; padding: 3rem 2rem;">
                    <i class="fas fa-layer-group" style="font-size: 3rem; color: var(--border-color); display: block; margin-bottom: 1rem;"></i>
                    <h3 style="color: var(--gray-text); font-weight: 600; margin-bottom: 0.75rem;">Nenhuma fila cadastrada</h3>
                    <p style="color: var(--gray-text); margin-bottom: 1.5rem;">Este estabelecimento ainda não possui filas de atendimento.</p>
                    <a href="/queues/create/{{establishment.id}}" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                        <i class="fas fa-plus"></i> Criar Primeira Fila
                    </a>
                </div>
            </div>
        {{/if}}
    </div>
</div>
