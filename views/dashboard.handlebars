<div class="dashboard-container">
    <!-- Cabeçalho do Dashboard -->
    <div class="dashboard-header">
        <h1>
            <i class="fas fa-tachometer-alt"></i> Bem-vindo, {{user.name}}!
        </h1>
        <p>Gerencie seus estabelecimentos e filas de forma inteligente</p>
    </div>

    <!-- Grid Principal do Dashboard -->
    <div class="dashboard-grid">
        
        <!-- SEÇÃO DO CLIENTE (Exclusiva para clientes/usuários padrão) -->
        {{#if (eq user.role 'user')}}
        <!-- Card: Minhas Filas -->
        <div class="dashboard-card" style="grid-column: span 12;">
            <div class="card-header">
                <h2><i class="fas fa-list-ul"></i> Minhas Filas</h2>
            </div>
            
            {{#if myQueues}}
                <div class="queues-list">
                    {{#each myQueues}}
                        <div class="queue-item">
                            <div class="queue-info">
                                <h4><i class="fas fa-layer-group"></i> {{name}}</h4>
                                <p><i class="fas fa-hospital"></i> {{establishmentName}}</p>
                            </div>
                            <div class="queue-actions">
                                <a href="/queues/{{id}}" class="btn btn-small btn-primary">
                                    <i class="fas fa-eye"></i> Detalhes
                                </a>
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <div class="empty-state">
                    <i class="fas fa-inbox" style="font-size: 2.5rem; opacity: 0.3; display: block; margin-bottom: 1rem;"></i>
                    <p>Você não está em nenhuma fila no momento</p>
                    <a href="/establishments" class="btn btn-small btn-primary" style="margin-top: 1rem; padding: 0.75rem 1.5rem;">
                        <i class="fas fa-search"></i> Explorar Filas & Estabelecimentos
                    </a>
                </div>
            {{/if}}
        </div>
        {{/if}}

        {{#if (eq user.role "admin")}}
            <!-- SEÇÃO EXCLUSIVA DE ESTABELECIMENTOS / ADMINISTRADORES -->
            <!-- Card: Meus Estabelecimentos -->
            <div class="dashboard-card" style="grid-column: span 12;">
                <div class="card-header">
                    <h2><i class="fas fa-hospital"></i> Meus Estabelecimentos</h2>
                </div>
                
                {{#if establishments}}
                    <div class="establishments-list">
                        {{#each establishments}}
                            <div class="establishment-item">
                                <div class="establishment-info">
                                    <h4><i class="fas fa-building"></i> {{name}}</h4>
                                    <p><i class="fas fa-tag"></i> {{type}}</p>
                                </div>
                                <div class="establishment-actions">
                                    <a href="/queues/establishment/{{id}}" class="btn btn-small btn-primary">
                                        <i class="fas fa-layer-group"></i> Filas
                                    </a>
                                    <a href="/establishments/edit/{{id}}" class="btn btn-small btn-secondary">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="empty-state">
                        <i class="fas fa-inbox" style="font-size: 2rem; opacity: 0.3; display: block; margin-bottom: 0.5rem;"></i>
                        <p>Você não tem estabelecimentos cadastrados</p>
                        <a href="/establishments/create" class="btn btn-primary" style="margin-top: 1rem;">
                            <i class="fas fa-plus"></i> Cadastrar Estabelecimento
                        </a>
                    </div>
                {{/if}}
            </div>

            <!-- Card: Estatísticas Rápidas -->
            <div class="dashboard-card" style="grid-column: span 12;">
                <h2><i class="fas fa-chart-bar"></i> Estatísticas</h2>
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-value">{{establishments.length}}</div>
                        <div class="stat-label">
                            <i class="fas fa-hospital"></i> Estabelecimentos
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">{{myQueues.length}}</div>
                        <div class="stat-label">
                            <i class="fas fa-layer-group"></i> Filas Ativas
                        </div>
                    </div>
                </div>
            </div>
        {{/if}}

    </div>

    <!-- Seção de Dicas Rápidas -->
    <div style="margin-top: 3rem; padding: 2rem; background: linear-gradient(135deg, rgba(0, 102, 204, 0.05) 0%, rgba(124, 58, 237, 0.05) 100%); border-radius: 12px; border-left: 5px solid #0066cc;">
        <h3 style="color: #0066cc; margin-bottom: 1rem;">
            <i class="fas fa-lightbulb"></i> Dicas Rápidas
        </h3>
        <ul style="list-style: none; padding: 0;">
            {{#if (eq user.role "admin")}}
                <li style="padding: 0.5rem 0;">
                    <i class="fas fa-check" style="color: #10b981; margin-right: 0.5rem;"></i>
                    Crie estabelecimentos para gerenciar suas filas
                </li>
                <li style="padding: 0.5rem 0;">
                    <i class="fas fa-check" style="color: #10b981; margin-right: 0.5rem;"></i>
                    Configure filas com capacidade e tempo de atendimento
                </li>
                <li style="padding: 0.5rem 0;">
                    <i class="fas fa-check" style="color: #10b981; margin-right: 0.5rem;"></i>
                    Acompanhe usuários em tempo real no painel administrativo
                </li>
                <li style="padding: 0.5rem 0;">
                    <i class="fas fa-check" style="color: #10b981; margin-right: 0.5rem;"></i>
                    Visualize estatísticas e otimize seu atendimento
                </li>
            {{else}}
                <li style="padding: 0.5rem 0;">
                    <i class="fas fa-check" style="color: #10b981; margin-right: 0.5rem;"></i>
                    Explore estabelecimentos e filas disponíveis na sua região
                </li>
                <li style="padding: 0.5rem 0;">
                    <i class="fas fa-check" style="color: #10b981; margin-right: 0.5rem;"></i>
                    Entre em uma fila de atendimento de forma totalmente remota
                </li>
                <li style="padding: 0.5rem 0;">
                    <i class="fas fa-check" style="color: #10b981; margin-right: 0.5rem;"></i>
                    Acompanhe sua posição na fila e o tempo de espera estimado em tempo real
                </li>
            {{/if}}
        </ul>
    </div>
</div>
