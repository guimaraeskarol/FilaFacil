<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h1 class="text-center mb-4">Entre em Contato</h1>
                    <p class="text-center text-muted mb-5">Tem alguma dúvida ou sugestão? Envie uma mensagem para nossa equipe.</p>
                    
                    <form>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="name" class="form-label">Nome</label>
                                <input type="text" class="form-control" id="name" placeholder="Seu nome">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" placeholder="seu@email.com">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="subject" class="form-label">Assunto</label>
                            <input type="text" class="form-control" id="subject" placeholder="Como podemos ajudar?">
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Mensagem</label>
                            <textarea class="form-control" id="message" rows="5" placeholder="Escreva sua mensagem aqui..."></textarea>
                        </div>
                        <div class="d-grid">
                            <button type="button" class="btn btn-primary btn-lg" onclick="alert('Mensagem enviada com sucesso! (Simulação)')">Enviar Mensagem</button>
                        </div>
                    </form>

                    <div class="mt-5 pt-4 border-top text-center">
                        <p class="mb-0">Também estamos disponíveis em:</p>
                        <p class="lead"><strong>contato@filafacil.com.br</strong></p>
                        <div class="mt-3">
                            <a href="#" class="btn btn-outline-secondary btn-sm me-2"><i class="fab fa-instagram"></i> Instagram</a>
                            <a href="#" class="btn btn-outline-secondary btn-sm me-2"><i class="fab fa-linkedin"></i> LinkedIn</a>
                            <a href="#" class="btn btn-outline-secondary btn-sm"><i class="fab fa-twitter"></i> Twitter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
